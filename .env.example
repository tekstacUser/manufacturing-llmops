# =========================================================
# Manufacturing Maintenance Intelligence Platform
# Environment configuration (copy this file to .env)
# =========================================================

# ---------- General ----------
COMPOSE_PROJECT_NAME=manufacturing-llmops

# ---------- Model file locations (host paths, pre-provisioned) ----------
# These directories must already contain the GGUF files before `docker compose up`.
MODELS_DIR=./models
SMALL_MODEL_PATH=/models/qwen-0.5b/qwen2.5-0.5b-instruct-q4_k_m.gguf
MEDIUM_MODEL_PATH=/models/qwen-1.5b/qwen2.5-1.5b-instruct-fp16.gguf
QUANTIZED_MODEL_PATH=/models/qwen-1.5b-q4/qwen2.5-1.5b-instruct-q4_k_m.gguf

# ---------- BentoML serving ports (host) ----------
SMALL_SERVICE_PORT=3001
MEDIUM_SERVICE_PORT=3002
QUANTIZED_SERVICE_PORT=3003

# ---------- Backend API / Frontend UI ----------
BACKEND_PORT=8002
FRONTEND_PORT=8001
SIMPLE_WORD_THRESHOLD=12

# ---------- CPU / performance tuning (4 vCPU / 15 GiB VM) ----------
# Keep total threads across simultaneously-running services <= vCPU count.
LLAMA_THREADS_SMALL=2
LLAMA_THREADS_MEDIUM=2
LLAMA_THREADS_QUANTIZED=2
LLAMA_CTX_SIZE=2048
LLAMA_MAX_TOKENS=256

# ---------- LiteLLM Gateway ----------
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-local-dev-key
LITELLM_REQUEST_TIMEOUT=60

# ---------- Langfuse (local OSS) ----------
# Host port is fixed at 3030 (http://localhost:3030) - do not change this
# to 3000, which is reserved/avoided throughout this stack.
LANGFUSE_PORT=3030
LANGFUSE_HOST=http://langfuse:3000
# Generate your own values the first time you set up Langfuse locally.
# See README.md -> "Configuring your .env file" for the exact, step-by-step
# instructions on where these come from (Langfuse UI -> Settings -> API Keys).
LANGFUSE_PUBLIC_KEY=pk-lf-4c175e09-b596-4f9f-a587-28d45a6a3bf8
LANGFUSE_SECRET_KEY=sk-lf-480afeec-2565-464e-9107-45d4c0e18391
LANGFUSE_DB_PORT=5433
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=langfuse
LANGFUSE_DB_NAME=langfuse
LANGFUSE_SALT=local-dev-salt-change-me
LANGFUSE_NEXTAUTH_SECRET=local-dev-nextauth-secret-change-me

# ---------- Token cost tracking ----------
PRICING_CONFIG_PATH=/app/config/pricing.yaml
